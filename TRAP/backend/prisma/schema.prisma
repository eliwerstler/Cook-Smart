// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// User model
model User {
  id              String   @id @default(cuid())
  username        String   @unique
  email           String   @unique
  passwordHash    String
  profilePhoto    String?
  bio             String?

  // Statistics
  totalStandards  Float    @default(0)
  avgBph          Float    @default(0)
  peakBph         Float    @default(0)
  lifetimeDrinks  Int      @default(0)

  // Timestamps
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  sessions        Session[]
  drinks          Drink[]
  likes           Like[]
  comments        Comment[]
  sentFriendships Friendship[] @relation("SentFriendships")
  receivedFriendships Friendship[] @relation("ReceivedFriendships")
  groupMemberships GroupMember[]
  createdGroups   Group[]

  @@index([username])
  @@index([email])
}

// Session model (drinking session)
model Session {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  startTime     DateTime
  endTime       DateTime?
  bph           Float    @default(0)
  coverPhotoId  String?

  totalDrinks   Int      @default(0)
  totalStandards Float   @default(0)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  drinks        Drink[]

  @@index([userId])
  @@index([startTime])
}

// Drink model (individual drink post)
model Drink {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId       String
  session         Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  photoUrl        String
  caption         String?
  drinkType       String
  alcoholContent  Float    // Standard drinks (1.0 for beer, 1.5 for wine, etc.)

  location        String?  // Optional location/bar name
  latitude        Float?
  longitude       Float?

  likesCount      Int      @default(0)
  commentsCount   Int      @default(0)

  timestamp       DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  likes           Like[]
  comments        Comment[]

  @@index([userId])
  @@index([sessionId])
  @@index([timestamp])
}

// Group model
model Group {
  id            String   @id @default(cuid())
  name          String
  description   String?
  coverPhoto    String?

  createdById   String
  createdBy     User     @relation(fields: [createdById], references: [id])

  memberCount   Int      @default(0)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  members       GroupMember[]

  @@index([createdById])
}

// Group membership
model GroupMember {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  groupId   String
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)

  role      String   @default("member") // member, admin
  joinedAt  DateTime @default(now())

  @@unique([userId, groupId])
  @@index([userId])
  @@index([groupId])
}

// Friendship model
model Friendship {
  id          String   @id @default(cuid())

  senderId    String
  sender      User     @relation("SentFriendships", fields: [senderId], references: [id], onDelete: Cascade)

  receiverId  String
  receiver    User     @relation("ReceivedFriendships", fields: [receiverId], references: [id], onDelete: Cascade)

  status      String   @default("pending") // pending, accepted, rejected

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([senderId, receiverId])
  @@index([senderId])
  @@index([receiverId])
}

// Like model
model Like {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  drinkId   String
  drink     Drink    @relation(fields: [drinkId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, drinkId])
  @@index([userId])
  @@index([drinkId])
}

// Comment model
model Comment {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  drinkId   String
  drink     Drink    @relation(fields: [drinkId], references: [id], onDelete: Cascade)

  content   String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([drinkId])
  @@index([createdAt])
}
